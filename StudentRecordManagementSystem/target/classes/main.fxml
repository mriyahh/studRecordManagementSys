<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="Controller">

    <!-- Input Fields -->
    <children>

        <Label text="Name:" layoutX="30" layoutY="30"/>
        <TextField fx:id="txtName" layoutX="100" layoutY="25" prefWidth="200"/>

        <Label text="Course:" layoutX="30" layoutY="70"/>
        <TextField fx:id="txtCourse" layoutX="100" layoutY="65" prefWidth="200"/>

        <Label text="Year Level:" layoutX="30" layoutY="110"/>
        <ChoiceBox fx:id="cbYear" layoutX="100" layoutY="105" prefWidth="200"/>

        <!-- Buttons -->
        <Button text="Add" layoutX="330" layoutY="25" prefWidth="100" onAction="#addStudent"/>
        <Button text="Update" layoutX="330" layoutY="65" prefWidth="100" onAction="#updateStudent"/>
        <Button text="Delete" layoutX="330" layoutY="105" prefWidth="100" onAction="#deleteStudent"/>
        <Button text="Clear" layoutX="330" layoutY="145" prefWidth="100" onAction="#clearFields"/>

        <!-- Table -->
        <TableView fx:id="table" layoutX="30" layoutY="200" prefWidth="600" prefHeight="300">

            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                <TableColumn fx:id="colName" text="Name" prefWidth="180"/>
                <TableColumn fx:id="colCourse" text="Course" prefWidth="180"/>
                <TableColumn fx:id="colYear" text="Year Level" prefWidth="160"/>
            </columns>

        </TableView>

    </children>

</AnchorPane>